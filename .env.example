# Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/gondola

# Modal Configuration (Required)
# Get these from: https://modal.com/settings
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal app name (used to group sandboxes)
MODAL_APP_NAME=gondola

# After running `bun run build:image`, paste the image ID here
MODAL_IMAGE_ID=

# Sandbox idle timeout (in milliseconds)
# Sandbox dies after this many minutes of inactivity (no HTTP requests)
# Default: 20 minutes = 1200000ms
SANDBOX_IDLE_TIMEOUT_MS=1200000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# GitHub OAuth
# Create an OAuth app at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API Configuration
PORT=3000
